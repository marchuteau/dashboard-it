SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=noreply@recommerce.com
RECIPIENT_EMAIL=marc.huteau@recommerce.com
PORT=3000

# Okta - vérification serveur du token envoyé par le front (Authorization: Bearer <id_token>)
# Valeur confirmée via les claims réels du token (voir log [Auth] Claims reçus) - l'URL
# d'autorisation utilise le domaine personnalisé, mais l'issuer réel est le domaine okta-emea
OKTA_ISSUER=https://recommerce.okta-emea.com/oauth2/default
OKTA_CLIENT_ID=0oak5r1481CKBgoeM0i7
ALLOWED_EMAIL_DOMAINS=recommerce.com,circularx.com
# Groupes Okta autorisés à consulter/supprimer les soumissions (admin.html)
ADMIN_GROUPS=Dashboard IT Admin,Recommerce Solutions (FR) - Ressources Humaines
# Groupe Okta autorisé à gérer les licences (plus restrictif que ADMIN_GROUPS)
IT_ADMIN_GROUP=Dashboard IT Admin

# Secret de signature des cookies de session (httpOnly) - générer une valeur aléatoire longue,
# ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-generate-a-random-64-char-secret
# Mettre à "production" une fois derrière HTTPS pour forcer le flag Secure sur le cookie de session
NODE_ENV=development
